# Conexão com o PostgreSQL
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/leaddashboard?schema=public"

# Porta do servidor (opcional, padrão 3000)
PORT=3000

# Segredo para assinar a sessão (qualquer texto longo e aleatório)
# Gere um com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Em produção (HTTPS), defina como production para o cookie ser "secure"
NODE_ENV=development

